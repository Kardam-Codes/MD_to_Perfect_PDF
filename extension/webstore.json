{
  "name": "MD → Perfect PDF",
  "short_name": "MDtoPDF",
  "description": "Turn Markdown into clean, print-ready PDFs with live preview and export controls. Privacy-first local processing.",
  "version": "1.1.0",
  "manifest_version": 3,
  "author": "Kardam Codes",
  "homepage_url": "https://kardam-codes.github.io/MD_to_Perfect_Pdf/website/",
  "permissions": {
    "permissions": [
      "storage"
    ],
    "host_permissions": [
      "http://localhost:3000/*",
      "https://md-to-perfect-pdf.onrender.com/*"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MD → Perfect PDF",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png", 
    "128": "icons/icon128.png"
  },
  "offline_enabled": true,
  "category": "productivity",
  "chrome_settings_overrides": {},
  "content_security_policy": {}
}